# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://stankobase:stankobase@localhost:5432/stankobase?schema=public"

# HTTP port the API listens on
PORT=4000

# Origin allowed by CORS - the Vite frontend's dev/prod URL
FRONTEND_ORIGIN="http://localhost:3000"

# JWT signing secrets - generate with `openssl rand -hex 32`, keep out of source control
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# Local disk storage root for machine_attachments (relative to server/ or absolute)
UPLOADS_DIR="./uploads"

# Max upload size in bytes (default 200MB)
MAX_UPLOAD_BYTES=209715200

# Bootstrap superadmin - the only account created by `npm run seed`.
# Change the password after first login; this account then creates every
# other user/role through the Users & Roles screen.
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_EMAIL="superadmin@stankobase.ru"
SUPERADMIN_PASSWORD="change-me-strong-password"
SUPERADMIN_FULL_NAME="Суперадминистратор"
